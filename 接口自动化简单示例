resp = post_form("/xxx/submit", data={"a": 1, "b": 2}, params={"traceId": "123"})

# 3) 文件上传
with open("a.png", "rb") as f:
    resp = post_multipart("/upload/image", files={"file": ("a.png", f, "image/png")})
