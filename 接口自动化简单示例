from test_config.usage import post_json
import pytest

@pytest.fixture()
def my_fixture():
    print("此项为 fixture 演示代码")
    yield {"ready": True}
    print("此项为后置操作 fixture")

def test_fixture_02(my_fixture):  #在这里直接传上面的函数名就行
    params = {"data": "dNSL5CBf9anb9wBaFDKAF8A9/T8CbZflJy2VZFlqhVo"}
    s = post_json("/kink-customer/v5/decrypt.e", params=params)   

    print(s.status_code, s.url)
    print("Body:", s.text)
if __name__ == '__main__':
    pytest.main([__file__])
