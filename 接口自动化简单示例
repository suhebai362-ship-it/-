参数化示例   在这个框架中我只使用了parametrize方式  yaml csv方式 我还是觉得在Jmeter这类工具里使用更加便捷 👇
---------------------------------------------------------------------------------------------------
import pytest
@pytest.mark.parametrize(("name", "姓氏"), [
    ("苏", "呼"),
    ("宁", "蓝"),
])
def test_get_method(name, 姓氏):
    print(name, 姓氏)

if __name__ == "__main__":
    pytest.main()
