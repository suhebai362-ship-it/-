#我使用的接口自动化框架是 pytest+allure+request
#与UI自动化相同 为了让代码更加简介 更贴近业务语言 我把request方法做了封装
#封装后 只需要从api_core.usage导入要使用的方式 即可更简洁的进行操作 同时，封装后 默认在使用后 打印出相关信息
----------------------------------------------------------------------------------------------------
from api_core.usage import get_method, post_form, post_json
def test_get_matchCD():
    get_method("/kink-customer/user/getMatchCD")
def test_clear():
    post_json("/kink-customer/user/clearCD")
if __name__ == '__main__':
    test_get_matchCD()
    test_clear()
